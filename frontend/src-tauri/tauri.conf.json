{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flint Prepress Studio",
  "version": "1.0.0",
  "identifier": "com.flint.prepress",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../.next-build"
  },
  "app": {
    "windows": [
      {
        "title": "Flint Prepress Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/flint-backend"
    ]
  }
}
