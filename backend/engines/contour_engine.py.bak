import base64
import os
from .bezier_utils import compute_bezier_control_points

HAS_OPENCV = False
HAS_PYMUPDF = False
try:
    import cv2
    import numpy as np
    HAS_OPENCV = True
except ImportError:
    pass
try:
    import fitz
    HAS_PYMUPDF = True
except ImportError:
    pass


def points_to_svg_cubic_bezier(points, tension=0.35, original_contour=None, seg_types=None):
    n = len(points)
    if n < 3:
        cmd = [f"M {points[0][0]},{points[0][1]}"]
        for pt in points[1:]:
            cmd.append(f"L {pt[0]},{pt[1]}")
            if seg_types is not None:
                seg_types.append(True)
        cmd.append("Z")
        return " ".join(cmd)

    if not isinstance(tension, (int, float)):
        tension = 0.35
    if tension <= 0.001:
        cmd = [f"M {points[0][0]:.2f},{points[0][1]:.2f}"]
        for pt in points[1:]:
            cmd.append(f"L {pt[0]:.2f},{pt[1]:.2f}")
            if seg_types is not None:
                seg_types.append(True)
        cmd.append("Z")
        return " ".join(cmd)

    cnt_pts = None
    if original_contour is not None:
        cnt_pts = np.squeeze(original_contour)
        if len(cnt_pts.shape) == 1:
            cnt_pts = cnt_pts.reshape(-1, 2)

    cmds = [f"M {points[0][0]:.2f},{points[0][1]:.2f}"]
    for i in range(n):
        p1 = np.array(points[i], dtype=float)
        p2 = np.array(points[(i + 1) % n], dtype=float)

        is_straight = False
        if cnt_pts is not None:
            idx1 = int(np.argmin(np.sum((cnt_pts - p1)**2, axis=1)))
            idx2 = int(np.argmin(np.sum((cnt_pts - p2)**2, axis=1)))
            
            if idx1 <= idx2:
                pts_seg = cnt_pts[idx1:idx2+1]
            else:
                pts_seg = np.concatenate([cnt_pts[idx1:], cnt_pts[:idx2+1]], axis=0)
            
            if len(pts_seg) > 2:
                v = p2 - p1
                v_len = np.linalg.norm(v)
                if v_len > 1e-6:
                    num = np.abs(v[1] * pts_seg[:, 0] - v[0] * pts_seg[:, 1] + p2[0]*p1[1] - p2[1]*p1[0])
                    dists = num / v_len
                    max_dist = np.max(dists)
                    if max_dist <= 1.5:
                        is_straight = True
                else:
                    is_straight = True
            else:
                is_straight = True
        elif seg_types is not None and i < len(seg_types):
            is_straight = seg_types[i]

        if is_straight:
            cmds.append(f"L {p2[0]:.2f},{p2[1]:.2f}")
            if seg_types is not None and cnt_pts is not None:
                seg_types.append(True)
            continue

        p0 = points[(i - 1) % n]
        p3 = points[(i + 2) % n]

        cp = compute_bezier_control_points(p0, p1, p2, p3, tension)
        if cp is None:
            cmds.append(f"L {p2[0]:.2f},{p2[1]:.2f}")
            if seg_types is not None and cnt_pts is not None:
                seg_types.append(True)
            continue

        cp1, cp2 = cp
        cmds.append(f"C {cp1[0]:.2f},{cp1[1]:.2f} {cp2[0]:.2f},{cp2[1]:.2f} {p2[0]:.2f},{p2[1]:.2f}")
        if seg_types is not None and cnt_pts is not None:
            seg_types.append(False)

    cmds.append("Z")
    return " ".join(cmds)

def offset_polygons(polygons, delta_val, offset_unit, dpi, w, h, simplify_factor=0.005):
    """
    Expands or contracts a set of polygons by delta_val.
    Used for live offset updates without destroying manual node modifications.
    """
    mask = np.zeros((int(h), int(w)), dtype=np.uint8)
    for pts in polygons:
        if len(pts) < 3: continue
        cnt = np.array(pts, dtype=np.int32)
        cv2.fillPoly(mask, [cnt], 255)
        
    if delta_val != 0:
        if offset_unit == "pt":
            offset_px = int(round((abs(delta_val) / 72.0) * dpi))
        elif offset_unit == "mm":
            offset_px = int(round((abs(delta_val) / 25.4) * dpi))
        elif offset_unit == "cm":
            offset_px = int(round((abs(delta_val) / 2.54) * dpi))
        elif offset_unit == "in":
            offset_px = int(round(abs(delta_val) * dpi))
        else:
            offset_px = int(round(abs(delta_val)))
            
        if offset_px > 0:
            kernel_size = max(3, offset_px * 2 + 1)
            kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (kernel_size, kernel_size))
            if delta_val > 0:
                mask = cv2.dilate(mask, kernel, iterations=1)
            else:
                mask = cv2.erode(mask, kernel, iterations=1)
                
    raw_contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    new_polygons = []
    for cnt in raw_contours:
        cnt = cv2.approxPolyDP(cnt, simplify_factor * cv2.arcLength(cnt, True), True)
        if len(cnt) < 3: continue
        pts = cnt.reshape(-1, 2).tolist()
        new_polygons.append(pts)
    return new_polygons


def generate_contour_cut_svg(img_path, offset_val=0.0, offset_unit="pt", threshold=20, simplify_factor=0.005, dpi=300, bg_mode="Automatic Alpha Channel (PNG Transparency)", stroke_color="#FF00FE", stroke_width=1.0, use_bezier=True, tension=0.35, keep_holes=False, add_white_matte=False, add_reg_marks=False, copies=1, pdf_page=0):
    if not HAS_OPENCV:
        raise RuntimeError("OpenCV (cv2) is not installed in the Python environment.")

    ext = os.path.splitext(img_path)[1].lower()
    is_pdf = ext == '.pdf'

    if is_pdf:
        if not HAS_PYMUPDF:
            raise RuntimeError("PyMuPDF (fitz) is not installed. Cannot process PDF files.")
        doc = fitz.open(img_path)
        if pdf_page < 0 or pdf_page >= len(doc):
            raise ValueError(f"PDF page {pdf_page + 1} out of range (total pages: {len(doc)})")
        page = doc[pdf_page]
        mat = fitz.Matrix(dpi / 72.0, dpi / 72.0)
        pix = page.get_pixmap(matrix=mat, alpha=False)
        img = np.frombuffer(pix.samples, dtype=np.uint8).reshape(pix.h, pix.w, pix.n)
        if pix.n == 4:
            img = cv2.cvtColor(img, cv2.COLOR_RGBA2BGRA)
        else:
            img = cv2.cvtColor(img, cv2.COLOR_RGB2BGR)
        h, w = pix.h, pix.w
        doc.close()
        page_label = f"page_{pdf_page + 1}_"
        # For SVG embedding: render pixmap as PNG bytes
        success, png_data = cv2.imencode('.png', img)
        if not success:
            raise RuntimeError("Failed to encode rendered PDF page as PNG.")
        img_b64 = base64.b64encode(png_data.tobytes()).decode("utf-8")
        mime = "image/png"
    else:
        img = cv2.imread(img_path, cv2.IMREAD_UNCHANGED)
        if img is None:
            raise ValueError(f"Could not load image file from {img_path}")
        h, w = img.shape[:2]

        with open(img_path, "rb") as f:
            img_b64 = base64.b64encode(f.read()).decode("utf-8")
        mime = "image/png" if ext == ".png" else "image/jpeg"

    if len(img.shape) == 2:
        img = cv2.cvtColor(img, cv2.COLOR_GRAY2BGR)

    has_real_alpha = False
    if img.shape[2] == 4:
        alpha_channel = img[:, :, 3]
        if np.min(alpha_channel) < 250 and np.std(alpha_channel) > 0.5:
            has_real_alpha = True

    if ("Alpha" in bg_mode or bg_mode == "Automatic") and has_real_alpha:
        alpha = img[:, :, 3]
        _, mask = cv2.threshold(alpha, threshold, 255, cv2.THRESH_BINARY)
    else:
        bgr = img[:, :, :3]

        if bg_mode.startswith("#") or (isinstance(bg_mode, (list, tuple)) and len(bg_mode) == 3):
            if isinstance(bg_mode, str):
                hx = bg_mode.lstrip('#')
                bg_color = np.array([int(hx[4:6], 16), int(hx[2:4], 16), int(hx[0:2], 16)], dtype=float)
            else:
                bg_color = np.array([bg_mode[2], bg_mode[1], bg_mode[0]], dtype=float)
        elif "White" in bg_mode:
            bg_color = np.array([255.0, 255.0, 255.0])
        elif "Dark" in bg_mode:
            bg_color = np.array([0.0, 0.0, 0.0])
        else:
            # Sample all border pixels around frame to estimate exact background color
            border_pixels = np.concatenate([
                bgr[0, :, :],
                bgr[h - 1, :, :],
                bgr[:, 0, :],
                bgr[:, w - 1, :]
            ], axis=0)
            bg_color = np.median(border_pixels, axis=0)

        # Calculate max channel color distance from background
        diff = cv2.absdiff(bgr, bg_color.astype(np.uint8))
        diff_dist = np.max(diff, axis=2)

        eff_thresh = max(6, threshold) if threshold > 0 else 10
        _, mask = cv2.threshold(diff_dist, eff_thresh, 255, cv2.THRESH_BINARY)

        # Light MORPH_OPEN to clean isolated speckle noise without merging adjacent shapes
        kernel_clean = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (3, 3))
        mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel_clean, iterations=1)

    if offset_unit == "mm":
        offset_px = int(round((offset_val / 25.4) * dpi))
    elif offset_unit == "cm":
        offset_px = int(round((offset_val / 2.54) * dpi))
    elif offset_unit == "inch":
        offset_px = int(round((offset_val) * dpi))
    elif offset_unit == "pt":
        offset_px = int(round((offset_val / 72.0) * dpi))
    else:
        offset_px = int(round(offset_val))

    if not keep_holes:
        mask_copy = mask.copy()
        h_m, w_m = mask.shape
        fill_mask = np.zeros((h_m + 2, w_m + 2), np.uint8)
        for corner in [(0, 0), (w_m - 1, 0), (0, h_m - 1), (w_m - 1, h_m - 1)]:
            if mask_copy[corner[1], corner[0]] == 0:
                cv2.floodFill(mask_copy, fill_mask, corner, 255)
        mask_inv = cv2.bitwise_not(mask_copy)
        mask = cv2.bitwise_or(mask, mask_inv)

        if offset_px != 0:
            ksize = abs(offset_px) * 2 + 1
            kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (ksize, ksize))
            if offset_px > 0:
                mask = cv2.dilate(mask, kernel, iterations=1)
            else:
                mask = cv2.erode(mask, kernel, iterations=1)

        contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    else:
        mask_clean = mask.copy()

        raw_contours, hierarchy = cv2.findContours(mask_clean, cv2.RETR_CCOMP, cv2.CHAIN_APPROX_SIMPLE)

        contours = []
        if raw_contours and hierarchy is not None:
            hierarchy = hierarchy[0]
            mask_outer = np.zeros((h, w), dtype=np.uint8)
            mask_holes = np.zeros((h, w), dtype=np.uint8)

            has_outer = False
            has_holes = False

            for idx, cnt in enumerate(raw_contours):
                if hierarchy[idx][3] == -1:
                    cv2.drawContours(mask_outer, [cnt], -1, 255, thickness=cv2.FILLED)
                    has_outer = True
                else:
                    cv2.drawContours(mask_holes, [cnt], -1, 255, thickness=cv2.FILLED)
                    has_holes = True

            if offset_px != 0:
                ksize = abs(offset_px) * 2 + 1
                kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (ksize, ksize))
                if offset_px > 0:
                    if has_outer:
                        mask_outer = cv2.dilate(mask_outer, kernel, iterations=1)
                    if has_holes:
                        mask_holes = cv2.dilate(mask_holes, kernel, iterations=1)
                else:
                    if has_outer:
                        mask_outer = cv2.erode(mask_outer, kernel, iterations=1)
                    if has_holes:
                        mask_holes = cv2.erode(mask_holes, kernel, iterations=1)

            if has_outer:
                cnts_outer, _ = cv2.findContours(mask_outer, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
                contours.extend(cnts_outer)
            if has_holes:
                cnts_holes, _ = cv2.findContours(mask_holes, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
                contours.extend(cnts_holes)

    path_d_list = []
    points_list = []
    shape_segments = []
    
    # Filter out tiny dust specs (anything smaller than ~1 square millimeter based on DPI)
    mm_in_pixels = dpi / 25.4
    min_area = max((w * h) * 0.00001, mm_in_pixels * mm_in_pixels)

    for cnt in contours:
        area = cv2.contourArea(cnt)
        if area < min_area:
            continue

        x_c, y_c, w_c, h_c = cv2.boundingRect(cnt)
        if w_c >= (w * 0.98) and h_c >= (h * 0.98):
            # Page borders are never cut paths
            continue

        epsilon = max(1.0, simplify_factor * cv2.arcLength(cnt, True))
        approx = cv2.approxPolyDP(cnt, epsilon, True)

        points = approx.reshape(-1, 2)
        if len(points) < 3:
            continue

        points_list.append(points.tolist())

        seg_types = []
        if use_bezier == "hybrid":
            path_d_list.append(points_to_svg_cubic_bezier(points, tension, original_contour=cnt, seg_types=seg_types))
        elif use_bezier:
            path_d_list.append(points_to_svg_cubic_bezier(points, tension, seg_types=seg_types))
        else:
            cmd = [f"M {points[0][0]},{points[0][1]}"]
            for pt in points[1:]:
                cmd.append(f"L {pt[0]},{pt[1]}")
                seg_types.append(True)
            cmd.append("Z")
            path_d_list.append(" ".join(cmd))

        shape_segments.append(seg_types)

    full_path_d = " ".join(path_d_list)

    white_matte_path = f'<path id="StickerWhiteMatte" fill="#FFFFFF" d="{full_path_d}"/>\n  ' if add_white_matte else ""

    svg_content = f"""<svg width="{w}" height="{h}" viewBox="0 0 {w} {h}" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
  <g id="Artwork">
    {white_matte_path}<image width="{w}" height="{h}" xlink:href="data:{mime};base64,{img_b64}"/>
  </g>
  <g id="CutContourLines">
    <path id="CutContour" stroke="{stroke_color}" stroke-width="{stroke_width}" fill="none" stroke-linejoin="round" stroke-linecap="round" d="{full_path_d}"/>
  </g>
</svg>"""

    return svg_content, len(contours), full_path_d, w, h, points_list, img_b64, mime, shape_segments
